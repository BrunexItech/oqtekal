# --- Required ---------------------------------------------------------------
# Postgres connection (docker compose dev DB listens on 5441)
DATABASE_URL=postgres://oqtekal:oqtekal@127.0.0.1:5441/oqtekal
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional; without it leads are only stored in the admin) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oqtekal <hello@oqtekal.com>"
# Where new enquiries are sent
LEADS_NOTIFY_TO=hello@oqtekal.com

# --- Cloudflare Turnstile spam protection (optional, recommended in prod) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Umami analytics (optional) ---------------------------------------------
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Live preview / draft mode ----------------------------------------------
PREVIEW_SECRET=change-me-too

# --- Seed (first run only) ---
SEED_ADMIN_EMAIL=admin@oqtekal.com
SEED_ADMIN_PASSWORD=
