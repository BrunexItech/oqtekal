# Copy to .env.production on the VPS (never commit the real file).
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://oqtekal.com
# Local port the site listens on (host nginx proxies to it). Must be free on the server.
WEB_PORT=8091

POSTGRES_USER=oqtekal
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=oqtekal
# openssl rand -hex 32
PAYLOAD_SECRET=
# openssl rand -hex 16
PREVIEW_SECRET=

SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hello@oqtekal.com
SMTP_PASS=
SMTP_FROM="Oqtekal <hello@oqtekal.com>"
LEADS_NOTIFY_TO=hello@oqtekal.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

BACKUP_DIR=/var/backups/oqtekal
BACKUP_REMOTE=
